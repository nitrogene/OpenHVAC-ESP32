  "version": "1.0.0",
  "sheet": {
    "title": "OpenHVAC-ESP32 — Airton ESP32-C6 Zigbee/Wi-Fi Controller",
    "grid": 10
  },
  "blocks": {
    "power_input": {
      "title": "12V HVAC Input, Reverse Polarity & USB OR-ing",
      "description": "JST XA 2.5 4-pin HVAC connector, AO3401A reverse polarity protection, 15V TVS, bulk capacitance, and Schottky OR-ing.",
      "origin": { "x": 100, "y": 100 }
    },
    "buck_3v3": {
      "title": "Synchronous Buck 12V/5V -> 3.3V (AP63203WU-7)",
      "description": "Direct 3.3V 2A synchronous step-down converter for ESP32-C6.",
      "origin": { "x": 450, "y": 100 }
    },
    "ldo_5v": {
      "title": "5V LDO for HVAC UART Level Shifters (AMS1117-5.0)",
      "description": "Low-current 5V rail for 74LVC1T45 VCCB with PWR LED providing minimum load.",
      "origin": { "x": 450, "y": 380 }
    },
    "mcu": {
      "title": "ESP32-C6-WROOM-1-N4 MCU, Reset & Boot",
      "description": "Main Wi-Fi 6 / Zigbee 3.0 module, EN RC delay, strapping pull-up, BOOT/RST buttons, STA LED.",
      "origin": { "x": 850, "y": 100 }
    },
    "usb": {
      "title": "Native USB-C Interface & ESD Protection",
      "description": "16-pin USB-C receptacle, 5.1k CC resistors, USBLC6-2SC6 ESD protection, 22 ohm series damping.",
      "origin": { "x": 100, "y": 420 }
    },
    "uart_level_shift": {
      "title": "Unidirectional UART 3.3V <-> 5V Level Shifters",
      "description": "Dual 74LVC1T45W6-7 isolating TX and RX between ESP32-C6 and Airton 5V bus.",
      "origin": { "x": 850, "y": 480 }
    }
  },
