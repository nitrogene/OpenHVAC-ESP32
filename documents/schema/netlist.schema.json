{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "netlist.schema.json",
  "title": "Declarative Schematic Netlist Schema",
  "description": "Entrant agnostique du pipeline Prompt -> Schéma (sch-synthesizer) : blocs fonctionnels, composants LCSC et connexions explicites broche à broche.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "sheet": {
      "type": "object",
      "description": "Paramètres de la feuille schématique EasyEDA Pro.",
      "properties": {
        "title": { "type": "string" },
        "grid": { "type": "number", "default": 10 }
      }
    },
    "blocks": {
      "type": "object",
      "description": "Blocs fonctionnels pour structurer le placement schématique par zones.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "origin": {
            "type": "object",
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            },
            "required": ["x", "y"]
          }
        },
        "required": ["title"]
      }
    },
    "components": {
      "type": "object",
      "description": "Instances de composants indexées par désignateur (ex: U1, R1, C1, J1).",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "block": {
            "type": "string",
            "description": "Clé du bloc fonctionnel parent dans 'blocks'."
          },
          "role": {
            "type": "string",
            "description": "Rôle fonctionnel dans le bloc."
          },
          "lcsc": {
            "type": "string",
            "pattern": "^C[0-9]+$",
            "description": "Code catalogue LCSC obligatoire (ex: C780769)."
          },
          "mpn": {
            "type": ["string", "null"],
            "description": "Référence fabricant (Manufacturer Part Number)."
          },
          "value": {
            "type": ["string", "null"],
            "description": "Valeur nominale (ex: 100nF, 10kΩ, null pour CI)."
          },
          "package": {
            "type": "string",
            "description": "Boîtier / empreinte attendue (ex: TSOT-23-6, 0603)."
          },
          "rotation": {
            "type": "number",
            "enum": [0, 90, 180, 270],
            "default": 0
          },
          "position": {
            "type": "object",
            "description": "Position schématique optionnelle (override du placement auto dans le bloc).",
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            },
            "required": ["x", "y"]
          }
        },
        "required": ["block", "role", "lcsc", "package"]
      }
    },
    "nets": {
      "type": "object",
      "description": "Connexions électriques explicites. Les noms auto-générés ($1N...) sont interdits.",
      "propertyNames": {
        "pattern": "^(?!\\$)[A-Za-z0-9_+.-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["power", "ground", "signal", "nc"],
            "description": "Nature du net (pilote NetFlag, NetPort, fil direct ou No-Connect)."
          },
          "style": {
            "type": "string",
            "enum": ["wire", "netport", "netflag", "nc_flag"],
            "description": "Force le mode de routage schématique (sinon déduit automatiquement de 'type' et des blocs)."
          },
          "pins": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_]+\\.[A-Za-z0-9_+/-]+$"
            },
            "description": "Liste des broches connectées au format DESIGNATOR.PIN (ex: U1.VIN, C1.1)."
          }
        },
        "required": ["type", "pins"]
      }
    }
  },
  "required": ["project", "version", "blocks", "components", "nets"]
}
